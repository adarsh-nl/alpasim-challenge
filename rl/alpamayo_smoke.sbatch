#!/bin/bash
# Alpamayo 2 Super — 20-scene smoke test. STAGED, NOT SUBMITTED.
#
# ONE QUESTION: would Alpamayo have avoided our two known zeros?
# Throughput and VRAM are secondary outputs, not the point. If Alpamayo gives
# the same answer as Diffusion-Planner on dd162898 and 8cc8fe63, the
# tail-specialist thesis is dead and it reduces to a reasoning-signal source.
#
# Submit with:  sbatch rl/alpamayo_smoke.sbatch
#
#SBATCH --job-name=alpamayo-smoke
#SBATCH --partition=ps
#SBATCH --account=ps
#SBATCH --qos=research
#SBATCH --gres=gpu:lovelace:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=02:00:00
#SBATCH --output=/home/nanjaiyalathaa/alpasim-challenge/logs/alpamayo_smoke_%j.out

set -euo pipefail

# ---------------------------------------------------------------------------
# PREREQUISITES — none of these are done; read before submitting
# ---------------------------------------------------------------------------
#  1. WEIGHTS (~68.4 GB, 15 safetensors shards). NOT downloaded.
#     Must NOT land in /home (cluster rule: no bulk data in /home). Stage to a
#     dataset area you own, once:
#
#       export HF_HOME=/datasets/eemcs/ps/cv/huggingface
#       hf download nvidia/Alpamayo2-Super --local-dir \
#         /datasets/eemcs/ps/cv/huggingface/alpamayo2-super
#
#  2. INFERENCE CODE. The HF repo ships weights + tokenizer/preprocessor configs
#     ONLY — no Python package. config.json targets `alpamayo2_super.*`, so the
#     code is required and comes from https://github.com/NVlabs/alpamayo2
#     (README states: "Source code: Apache License 2.0"). Clone + install into a
#     dedicated venv; do NOT install into the alpasim .venv, which the eval path
#     depends on.
#
#  3. CAMERA INPUT. Alpamayo is a VLA (vlm_class Qwen3VLForConditionalGeneration,
#     include_camera_ids=true) so it needs camera frames, which for our scenes
#     means MTGS renders. The 20 scenes here are all renderable.
#     NOTE this is DIAGNOSTIC use of eval-scene renders, not training on them —
#     distinct from the blocked render-training path in
#     reports/d2_render_set_is_the_eval_set.md. Worth a conscious decision
#     before running, not an assumption.
#
#  4. Confirm 2-way sharding fits. ~34 B params bf16 = 34.2 GB/card on 2x L40S
#     (48 GiB), leaving ~13 GB/card for activations + KV cache. Unmeasured —
#     that is one of the things this job measures. If it OOMs, go to 4 GPUs
#     (--gres=gpu:lovelace:4) rather than quantising: we want this model for
#     long-tail judgment, which is exactly what quantisation degrades.
# ---------------------------------------------------------------------------

echo "=== host=$(hostname) start=$(date -Is) ==="
nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader

export ALPASIM_NUPLAN_ROOT=/datasets/eemcs/ps/alpasim-nuplan-2026
export HF_HOME=/datasets/eemcs/ps/cv/huggingface
export LC_ALL=C.UTF-8
export TORCH_CUDA_ARCH_LIST="8.9"
module load nvidia/cuda-12.4

CHAL=/home/nanjaiyalathaa/alpasim-challenge
CKPT=/datasets/eemcs/ps/cv/huggingface/alpamayo2-super
CODE=/datasets/eemcs/ps/cv/huggingface/alpamayo2-code      # cloned NVlabs/alpamayo2

for p in "$CKPT/config.json" "$CODE"; do
  [ -e "$p" ] || { echo "MISSING PREREQUISITE: $p -- see the header" >&2; exit 1; }
done

SCRATCH="/local/$SLURM_JOB_ID"
mkdir -p "$SCRATCH/out"
trap 'rm -rf "$SCRATCH"' EXIT

source "$CODE/.venv/bin/activate"
python -c "import torch;print('torch',torch.__version__,'cuda',torch.cuda.is_available(),'n_gpu',torch.cuda.device_count())"

# The 20 scenes: the two known zeros first, then 18 renderable tail scenes.
# Generated by rl/make_alpamayo_smoke_scenes.py so the list is reproducible.
SCENES="$CHAL/rl/alpamayo_smoke_scenes.txt"
[ -f "$SCENES" ] || { echo "MISSING $SCENES -- run rl/make_alpamayo_smoke_scenes.py" >&2; exit 1; }
echo "=== $(wc -l < "$SCENES") scenes ==="
head -2 "$SCENES"

# run_alpamayo_teacher.py does not exist yet -- it is the deliberate gap.
# Writing it requires the NVlabs/alpamayo2 inference API, which I have not read
# (no code fetched, per the read-only constraint on that thread). Implement it
# against that API, mirroring rl/run_teacher.py's output contract so the
# existing label-integrity harness applies unchanged:
#     out/<map>_<scene>_<ts:03d>.npz with ego_future (N,4), token, map_name
python "$CHAL/rl/run_alpamayo_teacher.py" \
  --ckpt "$CKPT" \
  --scenes "$SCENES" \
  --root "$ALPASIM_NUPLAN_ROOT" \
  --out "$SCRATCH/out" \
  --devices 0,1 \
  --dtype bfloat16 \
  --emit-traces \
  --report "$SCRATCH/out/smoke_report.json"

echo "=== copying results back ==="
mkdir -p "$CHAL/rl/alpamayo_smoke_out"
rsync -a "$SCRATCH/out/" "$CHAL/rl/alpamayo_smoke_out/"

echo "=== THE QUESTION: compare against DP + the rank-1 follower on the zeros ==="
python "$CHAL/rl/compare_teachers_on_zeros.py" \
  --alpamayo "$CHAL/rl/alpamayo_smoke_out" \
  --dp "$CHAL/rl/teacher_labels" \
  --zeros dd162898ecf351d4,8cc8fe63227d5c07 || true

echo "=== done=$(date -Is) ==="
echo "Expected outputs: sec/sample with traces, peak VRAM per card, and for each"
echo "zero: Alpamayo's 6.4s trajectory vs DP's 8s vs what the follower actually"
echo "drove (6.24 m into a front collision on dd162898, human moved 3.64 m)."
